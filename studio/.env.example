# Virtual Humans Studio — environment
# Copy this file to `.env.local` and fill in your keys.

# --- Providers --------------------------------------------------------------
# Images (OpenAI gpt-image-1) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Voice (ElevenLabs TTS) — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Default character voice id — https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=

# Video (fal.ai: Kling / Veo / MiniMax / Runway) — https://fal.ai/dashboard/keys
FAL_KEY=

# --- Pricing overrides (optional, USD) --------------------------------------
# Used only for budget ESTIMATES. Confirm real prices with each provider.
ELEVENLABS_USD_PER_1K_CHARS=0.15
FAL_KLING_USD_PER_SEC=0.28
FAL_MINIMAX_USD_PER_SEC=0.05
FAL_VEO_USD_PER_SEC=0.4
FAL_RUNWAY_USD_PER_SEC=0.05
FAL_SEEDANCE_USD_PER_SEC=0.15
# Lip-sync (USD per minute of output video)
FAL_VEED_LIPSYNC_USD_PER_MIN=0.4
FAL_SYNC_LIPSYNC_USD_PER_MIN=8

# --- Supabase (budget + product screenshots) --------------------------------
# Required in production (Vercel). Server-side only — never prefix with NEXT_PUBLIC_.
# URL: Supabase dashboard → Project Settings → API → Project URL
SUPABASE_URL=
# service_role secret: Supabase dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- Access protection (recommended in production) --------------------------
# If set, the whole app + all API routes are locked behind this password
# (protects your paid generations). Leave EMPTY to keep open access (dev).
APP_PASSWORD=
# Optional hard cap on estimated spend (USD). Generations are blocked once the
# cumulative estimate reaches this value. Leave empty to disable.
BUDGET_CAP_USD=

# --- AI Command Center OS (envoi des clips vers la Médiathèque) --------------
# URL de l'instance AICCOS (production par défaut).
AICCOS_URL=https://aicommandcenteros.app
# Jeton partagé : même valeur que CLIPS_IMPORT_TOKEN côté AICCOS.
AICCOS_IMPORT_TOKEN=

# --- Feature flags ----------------------------------------------------------
# AI Video Director V2 (/director). Disabled by default.
# Set to 1 or true to enable local preview. Do not enable in production until ready.
# DIRECTOR_V2_ENABLED=0
DIRECTOR_V2_ENABLED=0

# Production worker V2 (VHS-114). Server-only. Off by default — no claim / no cron.
# DIRECTOR_V2_WORKER_ENABLED=0
DIRECTOR_V2_WORKER_ENABLED=0
# Paid provider generation via worker. Server-only. Off by default.
# Real execution requires BOTH worker + paid flags = 1|true.
# DIRECTOR_V2_PAID_GENERATION_ENABLED=0
DIRECTOR_V2_PAID_GENERATION_ENABLED=0

# Persist brief → project on Supabase (VHS-116). Server-only. Off by default.
# Requires DIRECTOR_V2_ENABLED=1 AND DIRECTOR_V2_WORKSPACE_ID + local/remote Supabase.
# DIRECTOR_V2_PERSISTENCE_ENABLED=0
DIRECTOR_V2_PERSISTENCE_ENABLED=0

# Marketing text AI adapter (VHS-117A). Server-only. Off by default.
# Real OpenAI call requires BOTH flags = 1|true. Not an alias of PAID_GENERATION.
# DIRECTOR_V2_MARKETING_AI_ENABLED=0
DIRECTOR_V2_MARKETING_AI_ENABLED=0
# Creative text AI adapter (VHS-118A). Server-only. Off by default.
# Real OpenAI call requires CREATIVE_AI + PAID_AI. Not wired to /director yet.
# DIRECTOR_V2_CREATIVE_AI_ENABLED=0
DIRECTOR_V2_CREATIVE_AI_ENABLED=0
# DIRECTOR_V2_PAID_AI_ENABLED=0
DIRECTOR_V2_PAID_AI_ENABLED=0
# Script text AI adapter (VHS-119A). Requires SCRIPT_AI + PAID_AI.
# DIRECTOR_V2_SCRIPT_AI_ENABLED=0
DIRECTOR_V2_SCRIPT_AI_ENABLED=0
# Art text AI adapter (VHS-120A). Requires ART_AI + PAID_AI.
# DIRECTOR_V2_ART_AI_ENABLED=0
DIRECTOR_V2_ART_AI_ENABLED=0
# Storyboard text AI adapter (VHS-121A). Requires STORYBOARD_AI + PAID_AI.
# DIRECTOR_V2_STORYBOARD_AI_ENABLED=0
DIRECTOR_V2_STORYBOARD_AI_ENABLED=0

# OpenAI Marketing analyzer (Responses API). Model configurable — no hardcode in call sites.
# OPENAI_MARKETING_MODEL=gpt-5.6-terra
OPENAI_MARKETING_MODEL=gpt-5.6-terra
# Reasoning effort: none|minimal|low|medium|high|xhigh
# OPENAI_MARKETING_REASONING_EFFORT=low
OPENAI_MARKETING_REASONING_EFFORT=low
# Optional output token cap (256..16384). Empty → default 4096.
OPENAI_MARKETING_MAX_OUTPUT_TOKENS=

# OpenAI Creative analyzer (Responses API). Not wired to UI/API yet.
# OPENAI_CREATIVE_MODEL=gpt-5.6-terra
OPENAI_CREATIVE_MODEL=gpt-5.6-terra
# OPENAI_CREATIVE_REASONING_EFFORT=low
OPENAI_CREATIVE_REASONING_EFFORT=low
# Optional output token cap (256..16384). Empty → default 1600.
OPENAI_CREATIVE_MAX_OUTPUT_TOKENS=
# OpenAI Script analyzer (Responses API). Not wired to UI/API yet.
# OPENAI_SCRIPT_MODEL=gpt-5.6-terra
OPENAI_SCRIPT_MODEL=gpt-5.6-terra
# OPENAI_SCRIPT_REASONING_EFFORT=low
OPENAI_SCRIPT_REASONING_EFFORT=low
# Optional output token cap (256..16384). Empty → default 2400.
OPENAI_SCRIPT_MAX_OUTPUT_TOKENS=
# OpenAI Art analyzer (Responses API).
# OPENAI_ART_MODEL=gpt-5.6-terra
OPENAI_ART_MODEL=gpt-5.6-terra
# OPENAI_ART_REASONING_EFFORT=low
OPENAI_ART_REASONING_EFFORT=low
# Optional output token cap (256..16384). Empty → default 2800.
OPENAI_ART_MAX_OUTPUT_TOKENS=
# OpenAI Storyboard analyzer (Responses API).
# OPENAI_STORYBOARD_MODEL=gpt-5.6-terra
OPENAI_STORYBOARD_MODEL=gpt-5.6-terra
# OPENAI_STORYBOARD_REASONING_EFFORT=low
OPENAI_STORYBOARD_REASONING_EFFORT=low
# Optional output token cap (256..16384). Empty → default 3200.
OPENAI_STORYBOARD_MAX_OUTPUT_TOKENS=
# OPENAI_SCRIPT_REQUIRE_PRICING=0
# OPENAI_ART_REQUIRE_PRICING=0
# OPENAI_STORYBOARD_REQUIRE_PRICING=0
# OPENAI_CREATIVE_REQUIRE_PRICING=0
# Optional HMAC salt for safety_identifier (never APP_PASSWORD / email).
# OPENAI_SAFETY_IDENTIFIER_SECRET=
# Optional firm pricing gate: set to 1 to block real calls without price book.
# OPENAI_MARKETING_REQUIRE_PRICING=0
# Optional injected token prices (minor USD / 1M tokens) — never commit real secrets.
# OPENAI_MARKETING_PRICE_VERSION=
# OPENAI_MARKETING_PRICE_INPUT_PER_MILLION_MINOR=
# OPENAI_MARKETING_PRICE_OUTPUT_PER_MILLION_MINOR=
# OPENAI_MARKETING_PRICE_CACHED_INPUT_PER_MILLION_MINOR=

# --- V2 persistence (VHS-113) ------------------------------------------------
# UUID du workspace pilote (single_workspace). Résolu uniquement côté serveur.
# Créer la ligne `workspaces` après application des migrations V2 (voir
# docs/Developer-Handover/SUPABASE_V2_MIGRATION_PLAN.md). Pas de valeur par défaut.
# Local seed: npm run supabase:seed-workspace (localhost only).
DIRECTOR_V2_WORKSPACE_ID=

# --- SDK source (optional) --------------------------------------------------
# By default the app reads the SDK from the parent folder (..).
# SDK_ROOT=C:\\Users\\JavaChrist\\Desktop\\virtual-humans
# CHARACTER_DIR_NAME=Mei SDK v1.0.0
