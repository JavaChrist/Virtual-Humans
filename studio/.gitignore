# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/.e2e-runtime.json
/.e2e-server.env
/.e2e-server-off.env
/supabase/.branches/
/supabase/.temp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# studio runtime data (spend log)
/.data

# Local Supabase CLI (secrets, edge runtime cache) — never commit
/supabase/.temp/

# MT-013F / MV-001 private media & local prep artifacts (never commit media/bytes)
/.tmp/
/.private-media/
/private-media/
**/mv001-media/**
