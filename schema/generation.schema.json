{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtual-humans.local/schema/generation.schema.json",
  "title": "Generation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "generation_id": { "type": "string" },
    "category": { "type": "string", "enum": ["image", "video", "voice"] },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "approved", "rejected"] },
    "inputs": { "type": "object", "additionalProperties": true },
    "outputs": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  },
  "required": ["generation_id", "category"]
}
